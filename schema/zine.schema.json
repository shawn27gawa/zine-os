{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zineos.dev/schema/zine.schema.json",
  "title": "ZineOS Publication Schema",
  "description": "Defines the machine-readable structure of a ZineOS publication.",
  "type": "object",
  "required": [
    "zineos_version",
    "project",
    "assets",
    "sequence",
    "pages",
    "output"
  ],
  "properties": {
    "zineos_version": {
      "type": "string",
      "minLength": 1,
      "description": "The ZineOS format version used by this project."
    },

    "project": {
      "$ref": "#/$defs/project"
    },

    "metadata": {
      "$ref": "#/$defs/metadata"
    },

    "assets": {
      "type": "array",
      "description": "Source materials referenced by the publication.",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },

    "sequence": {
      "type": "array",
      "description": "The high-level editorial sequence of the publication.",
      "items": {
        "$ref": "#/$defs/sequenceItem"
      }
    },

    "pages": {
      "type": "array",
      "minItems": 1,
      "description": "The ordered page and spread structure of the publication.",
      "items": {
        "$ref": "#/$defs/pageUnit"
      }
    },

    "output": {
      "$ref": "#/$defs/output"
    }
  },

  "additionalProperties": false,

  "$defs": {
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "language",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique project identifier."
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string"
        },

        "language": {
          "type": "string",
          "minLength": 2,
          "description": "Primary language of the publication."
        },

        "status": {
          "type": "string",
          "enum": [
            "draft",
            "editing",
            "review",
            "final",
            "published",
            "archived"
          ]
        }
      },

      "additionalProperties": false
    },

    "metadata": {
      "type": "object",
      "properties": {
        "creator": {
          "type": "string"
        },

        "contributors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "edition": {
          "type": "integer",
          "minimum": 1
        },

        "created": {
          "type": "string"
        },

        "published": {
          "type": [
            "string",
            "null"
          ]
        },

        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },

      "additionalProperties": true
    },

    "asset": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "type": "string",
          "enum": [
            "image",
            "text",
            "illustration",
            "map",
            "scan",
            "audio",
            "video",
            "data",
            "other"
          ]
        },

        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path or source reference for the asset."
        },

        "title": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },

      "additionalProperties": false
    },

    "sequenceItem": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "title": {
          "type": "string"
        },

        "description": {
          "type": "string"
        }
      },

      "additionalProperties": false
    },

    "pageUnit": {
      "type": "object",
      "required": [
        "id",
        "pages",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "One page number for a single page or two page numbers for a spread."
        },

        "section": {
          "type": "string",
          "description": "Identifier of the editorial sequence section this page belongs to."
        },

        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "block.schema.json"
          }
        },

        "layout": {
          "$ref": "#/$defs/layout"
        },

        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },

      "additionalProperties": false
    },

    "layout": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic layout identifier."
        },

        "variant": {
          "type": "string"
        },

        "notes": {
          "type": "string"
        },

        "settings": {
          "type": "object",
          "additionalProperties": true
        }
      },

      "additionalProperties": false
    },

    "output": {
      "type": "object",
      "required": [
        "medium"
      ],
      "properties": {
        "medium": {
          "type": "string",
          "enum": [
            "print",
            "digital",
            "web"
          ]
        },

        "page_size": {
          "type": "string"
        },

        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ]
        },

        "binding": {
          "type": "string"
        },

        "bleed_mm": {
          "type": "number",
          "minimum": 0
        },

        "color_mode": {
          "type": "string",
          "enum": [
            "RGB",
            "CMYK",
            "grayscale"
          ]
        },

        "resolution_dpi": {
          "type": "integer",
          "minimum": 1
        }
      },

      "additionalProperties": false
    }
  }
}
